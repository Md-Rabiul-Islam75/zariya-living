# Enquiry forms email every lead through SMTP (Nodemailer).
# Copy this file to .env and fill in the values. .env is never committed.
#
# Any SMTP provider works. For Resend use:
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=resend           SMTP_PASS=<your Resend API key>

SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for port 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# The sender. Its domain must be verified with your SMTP provider.
MAIL_FROM="Zariya Website <no-reply@zariyaliving.com>"
# Who receives the leads.
MAIL_TO=info@zariyaliving.com
